#include "main.h"

int main(int argc, char **argv) {
    if (argc != 2) {
        fprintf(stderr, "Usage: %s <NUMBER_OF_NEW_USERS>\n", argv[0]);
        exit(EXIT_FAILURE);
    }

    int n_new_users = atoi(argv[1]);
    if (n_new_users <= 0) {
        fprintf(stderr, "Error: Number of new users must be a positive integer\n");
        exit(EXIT_FAILURE);
    }

    printf("Adding %d new user processes to the simulation...\n", n_new_users);

    for (int i = 0; i < n_new_users; i++) {
        pid_t pid = fork();
        
        if (pid == -1) {
            perror("Fork failed");
            exit(EXIT_FAILURE);
        }
        
        if (pid == 0) {  // Child process
            execv("./user", (char*[]){ "user", NULL });
            perror("execv user failed");
            exit(EXIT_FAILURE);
        }
    }

    return EXIT_SUCCESS;
}